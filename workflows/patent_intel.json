    },
    "Query Provided?": {
      "main": [
        [{ "node": "Hybrid Search", "type": "main", "index": 0 }],
        [{ "node": "Build Error", "type": "main", "index": 0 }]
      ]
    },
    "Hybrid Search": {
      "main": [
        [{ "node": "LLM Analysis", "type": "main", "index": 0 }],
