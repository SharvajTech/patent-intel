# === Patent Intel Agent — Environment Configuration ===

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=patent_chunks

# --- Embeddings ---
# all-MiniLM-L6-v2: lightweight (90MB), 384-dim, runs on CPU with ~500MB RAM
# Switch to BAAI/bge-m3 (1024-dim) if you have a GPU or 8GB+ free RAM
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Set to "stub" for smoke testing without downloading any model
EMBEDDING_BACKEND=bge-m3

# --- BM25 ---
BM25_K1=1.5
BM25_B=0.75

# --- Hybrid Search (RRF) ---
RRF_K=60
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5

# --- Ollama (LLM) ---
# On Linux: use docker bridge IP so container can reach host Ollama
# Run: sudo systemctl edit ollama → add Environment="OLLAMA_HOST=0.0.0.0:11434"
OLLAMA_HOST=http://172.17.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180

# --- n8n (optional, enable with: docker compose --profile n8n up -d) ---
N8N_PORT=5678
